# 复制本文件为 .env，再填写 TokenHub 控制台创建的真实密钥。
# 不要把 .env 提交到 Git；API Key 需要允许调用下面两个模型。
TOKENHUB_API_KEY=your_tokenhub_api_key_here

# 腾讯云 TokenHub 境内 OpenAI 兼容接口。
TOKENHUB_BASE_URL=https://tokenhub.tencentmaas.com/v1

# HY4 负责根据检索资料生成回答。
TOKENHUB_CHAT_MODEL=hy4

# HY4 不是 Embedding 模型；检索向量化使用 TokenHub 文本向量模型。
TOKENHUB_EMBEDDING_MODEL=kinfra-text-embedding-0.6b
